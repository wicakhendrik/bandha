DATABASE_URL=postgres://bandha:bandha@localhost:5434/bandha
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
MARKET_PROVIDER=coingecko
MARKET_SYNC_INTERVAL_MIN=15
# COINGECKO_API_KEY=

# Web (server-side only)
API_URL=http://localhost:4000

# Akun demo lokal untuk uji manual (hanya dev, jangan dipakai di produksi)
# DEMO_EMAIL=demo@bandha.test
# DEMO_PASSWORD=demo-bandha-2026

# Migrasi dari FinMap (hanya dipakai skrip `pnpm --filter @bandha/api migrate:finmap`; jangan dicommit)
# FINMAP_DATABASE_URL=postgres://user:password@host:5432/finmap

# Mobile (Expo). Perangkat fisik: isi dengan IP LAN, mis. http://192.168.1.10:4000
# EXPO_PUBLIC_API_URL=

# Email (lupa kata sandi). Dev: "console" mencetak email ke terminal API. Produksi wajib "smtp".
MAIL_TRANSPORT=console
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Bandha <no-reply@bandha.grezly.app>"
# Microsoft 365: SMTP_URL=smtp://user%40domain.com:PASSWORD@smtp.office365.com:587/?requireTLS=true  (see docs/EMAIL.md; test with `pnpm --filter @bandha/api mail:test you@example.com`)
# Masuk/daftar dengan Google (docs/GOOGLE-LOGIN.md). Client ID "Web application" dari Google Cloud; kosong = fitur mati.
# Dipakai API (memeriksa token) dan web (menggambar tombol). Boleh beberapa, dipisah koma; yang pertama dipakai tombol web.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Mobile: nilai yang sama, tertanam saat build (kosong = tombol Google tidak muncul di aplikasi)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Registration needs an emailed 6-digit code; "false" turns it off (emergency only). In development with MAIL_TRANSPORT=console the code is printed in the API terminal.
# REQUIRE_EMAIL_OTP=true
# Alamat publik web untuk tautan di email (default: WEB_ORIGIN pertama)
# APP_URL=https://bandha.grezly.app
