# Copy to deploy/.env on the server (one per environment) and fill it in. deploy/.env is never committed.
#
#   development : COMPOSE_PROJECT_NAME=bandha-dev   WEB_PORT=3100  API_PORT=4100  APP_ENV=development
#   production  : COMPOSE_PROJECT_NAME=bandha-prod  WEB_PORT=3000  API_PORT=4000  APP_ENV=production
#
# The project name keeps the two stacks (containers, network, database volume) completely separate.

COMPOSE_PROJECT_NAME=bandha-dev

# --- database (created automatically on the first start; the password is only used inside the stack) ---
POSTGRES_USER=bandha
POSTGRES_DB=bandha
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- API ---
# At least 32 characters. Generate: openssl rand -hex 32. Use a DIFFERENT value per environment; changing it signs everyone out.
JWT_SECRET=
# "production" refuses MAIL_TRANSPORT=console (it would print password-reset links into the logs).
APP_ENV=development

# Public address of the web app (no trailing slash). Used in emailed links and CORS.
WEB_ORIGIN=https://bandha-dev.grezly.app
APP_URL=https://bandha-dev.grezly.app

# Prices: coingecko in real environments. Optional demo key raises the rate limit.
MARKET_PROVIDER=coingecko
MARKET_SYNC_INTERVAL_MIN=15
COINGECKO_API_KEY=

# Email for "forgot password". console = print to the API log (fine for development only). Production needs smtp.
MAIL_TRANSPORT=console
# Special characters in the SMTP password must be URL-encoded (@ = %40, & = %26, # = %23, $ = %24).
# smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Bandha <no-reply@bandha.grezly.app>"
# Registration needs a 6-digit code sent by email. Leave on; "false" is only an emergency switch when email cannot be sent.
# Microsoft 365 example and troubleshooting: docs/EMAIL.md
REQUIRE_EMAIL_OTP=true

# Sign in / sign up with Google: the "Web application" OAuth client id from Google Cloud (docs/GOOGLE-LOGIN.md). Empty = off.
# Used by the API (checks the token) and by the web app (draws the button); read at run time, so a restart is enough.
GOOGLE_CLIENT_ID=

# --- local ports the reverse proxy forwards to (bound to 127.0.0.1 only) ---
WEB_PORT=3100
API_PORT=4100

# --- deploy helper ---
# Back the database up before every deploy (recommended for production).
BACKUP_BEFORE_DEPLOY=0
# How many backup files to keep in deploy/backups.
BACKUP_KEEP=14
