{
  "name": "@bandha/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "mail:test": "tsx --env-file=../../.env src/mail-test.ts",
    "migrate:finmap": "tsx --env-file=../../.env src/migrate/finmap-cli.ts",
